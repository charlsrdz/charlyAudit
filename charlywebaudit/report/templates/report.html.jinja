<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<title>charlyWebAudit — Reporte de {{ report.url }}</title>
<style>
  :root {
    --brand: #b87619;
    --brand-light: #cc8a24;
    --bg: #0e1020;
    --surface: #171a2e;
    --surface2: #1f2440;
    --border: #2a2f4c;
    --text: #e7e9f5;
    --muted: #8a90b5;
    --ok: #34d399;
    --err: #ff6b5e;
    --warn: #f5b544;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
    background: var(--bg); color: var(--text); line-height: 1.55;
  }
  header {
    padding: 20px 32px; background: var(--surface); border-bottom: 1px solid var(--border);
    position: sticky; top: 0; z-index: 5;
  }
  header h1 { margin: 0 0 4px; font-size: 20px; }
  header .meta { color: var(--muted); font-size: 13px; }
  header .meta code { color: var(--brand-light); }
  .layout { max-width: 1180px; margin: 0 auto; padding: 24px 32px 80px; display: grid; grid-template-columns: 200px 1fr; gap: 32px; }
  nav.toc {
    position: sticky; top: 88px; align-self: start; font-size: 13px;
  }
  nav.toc div.toc-title { color: var(--muted); text-transform: uppercase; font-size: 11px; letter-spacing: .06em; margin-bottom: 8px; }
  nav.toc a { display: block; color: var(--text); text-decoration: none; padding: 5px 0; border-left: 2px solid transparent; padding-left: 10px; }
  nav.toc a:hover { color: var(--brand-light); border-left-color: var(--brand); }
  main { min-width: 0; }
  section { margin-bottom: 32px; scroll-margin-top: 88px; }
  h2 {
    font-size: 15px; text-transform: uppercase; letter-spacing: .06em;
    color: var(--brand); border-bottom: 1px solid var(--border); padding-bottom: 8px;
  }
  .card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: 16px 18px; margin-bottom: 12px;
  }
  .badge {
    display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 12px; font-weight: 600;
  }
  .badge--ok { background: rgba(52,211,153,.15); color: var(--ok); }
  .badge--fail { background: rgba(255,107,94,.15); color: var(--err); }
  .badge--skip { background: rgba(138,144,181,.15); color: var(--muted); }
  .case__title { font-weight: 600; margin-bottom: 4px; display: flex; align-items: center; gap: 8px; }
  .case__meta { color: var(--muted); font-size: 12px; margin-bottom: 8px; }
  .case__bar { height: 4px; border-radius: 2px; background: var(--surface2); margin-bottom: 10px; overflow: hidden; }
  .case__bar-fill { height: 100%; border-radius: 2px; }
  .card--passed { border-left: 3px solid var(--ok); }
  .card--failed { border-left: 3px solid var(--err); }
  .card--skipped { border-left: 3px solid var(--muted); }
  .ai-analysis h4 { color: var(--brand); font-size: 14px; margin: 16px 0 6px; }
  .ai-analysis h4:first-child { margin-top: 0; }
  .ai-analysis :is(p, li) { color: var(--text); }
  pre {
    background: var(--surface2); border: 1px solid var(--border); border-radius: 8px;
    padding: 10px 12px; overflow-x: auto; font-size: 13px; white-space: pre-wrap; word-break: break-word;
  }
  .scope-card summary {
    cursor: pointer; font-weight: 600; padding: 4px 0; list-style: none;
  }
  .scope-card summary::-webkit-details-marker { display: none; }
  .scope-card summary::before { content: "▸ "; color: var(--brand); }
  .scope-card[open] summary::before { content: "▾ "; }
  .scope-card .body { padding-top: 10px; border-top: 1px solid var(--border); margin-top: 10px; }
  .scope-card .body :is(p, li) { color: var(--text); }
  .scope-card .body code { background: var(--surface2); padding: 1px 5px; border-radius: 4px; }
  .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }
  .summary-grid .num { font-size: 22px; font-weight: 700; }
  .summary-grid .lbl { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  .pass-rate-bar { height: 10px; border-radius: 999px; background: var(--surface2); overflow: hidden; margin-top: 12px; display: flex; }
  .pass-rate-bar .seg--ok { background: var(--ok); }
  .pass-rate-bar .seg--fail { background: var(--err); }
  .pass-rate-bar .seg--skip { background: var(--muted); }
  .headers-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .headers-table td { padding: 6px 8px; border-bottom: 1px solid var(--border); }
  .headers-table td:first-child { color: var(--muted); width: 35%; }
  .headers-table code { color: var(--brand-light); }
  footer { text-align: center; color: var(--muted); font-size: 12px; padding: 24px; }

  @media print {
    header { position: static; }
    nav.toc { display: none; }
    .layout { grid-template-columns: 1fr; }
    body { background: #fff; color: #111; }
    .card, pre { background: #f5f5f5; border-color: #ccc; }
  }
</style>
</head>
<body>
<header>
  <h1>Reporte de auditoría — charlyWebAudit{% if report.test_name %} · {{ report.test_name }}{% endif %}</h1>
  <div class="meta">
    URL: <code>{{ report.url }}</code> · Spec: <code>{{ report.spec_path }}</code><br>
    Generado: {{ report.generated_at.split("T")[0] }} {{ report.generated_at.split("T")[1][:8] if "T" in report.generated_at else "" }} UTC
  </div>
</header>
<div class="layout">
<nav class="toc">
  <div class="toc-title">En este reporte</div>
  <a href="#resumen">Resumen</a>
  {% if report.ai_analysis_html %}<a href="#ia">Análisis por IA</a>{% endif %}
  {% if report.headers %}<a href="#cabeceras">Cabeceras HTTP</a>{% endif %}
  <a href="#casos">Casos de Playwright</a>
  {% if report.extension_used %}
  {% if report.kpis_html %}<a href="#kpis">KPIs de la sesión</a>{% endif %}
  <a href="#ambitos">Análisis por ámbito</a>
  {% endif %}
</nav>
<main>

  {% if report.browser_outcome == "closed_unexpectedly" %}
  <section>
    <div class="card" style="border-color: var(--err); background: rgba(255,107,94,0.08);">
      <strong style="color: var(--err);">⚠ El navegador se cerró de forma inesperada durante esta corrida.</strong>
      {{ report.browser_outcome_description }}
    </div>
  </section>
  {% endif %}

  {% if report.extension_used and not report.assistant_analysis_complete %}
  <section>
    <div class="card" style="border-color: var(--err); background: rgba(255,107,94,0.08);">
      <strong style="color: var(--err);">⚠ Análisis del Asistente incompleto.</strong>
      El navegador se cerró antes de que el Asistente pudiera analizar los 15 ámbitos de esta
      corrida — los resultados de Playwright abajo son completos y reales, pero la sección
      "Análisis del Asistente IA" no tiene contenido para esta corrida.
    </div>
  </section>
  {% endif %}

  <section id="resumen">
    <h2>Resumen</h2>
    <div class="card summary-grid">
      <div><div class="num" style="color:var(--ok)">{{ report.playwright.passed }}</div><div class="lbl">Pasaron</div></div>
      <div><div class="num" style="color:var(--err)">{{ report.playwright.failed }}</div><div class="lbl">Fallaron</div></div>
      <div><div class="num">{{ report.playwright.skipped }}</div><div class="lbl">Omitidos</div></div>
      <div><div class="num">{{ "%.1f"|format(report.playwright.duration_ms / 1000) }}s</div><div class="lbl">Duración</div></div>
    </div>
    {% set _total = report.playwright.passed + report.playwright.failed + report.playwright.skipped %}
    {% if _total > 0 %}
    <div class="pass-rate-bar">
      {% if report.playwright.passed %}<div class="seg--ok" style="width: {{ (report.playwright.passed / _total * 100) | round(1) }}%"></div>{% endif %}
      {% if report.playwright.failed %}<div class="seg--fail" style="width: {{ (report.playwright.failed / _total * 100) | round(1) }}%"></div>{% endif %}
      {% if report.playwright.skipped %}<div class="seg--skip" style="width: {{ (report.playwright.skipped / _total * 100) | round(1) }}%"></div>{% endif %}
    </div>
    {% endif %}
    {% if report.browser_outcome and report.browser_outcome != "closed_unexpectedly" %}
    <p style="color: var(--muted); font-size: 13px; margin-top: 8px;">{{ report.browser_outcome_description }}</p>
    {% endif %}
  </section>

  {% if report.ai_analysis_html %}
  <section id="ia">
    <h2>Análisis por IA</h2>
    <div class="card ai-analysis">{{ report.ai_analysis_html | safe }}</div>
  </section>
  {% endif %}

  {% if report.headers %}
  <section id="cabeceras">
    <h2>Cabeceras HTTP personalizadas</h2>
    <div class="card">
      <table class="headers-table">
        {% for name, value in report.headers.items() %}
        <tr><td><code>{{ name }}</code></td><td>{{ value }}</td></tr>
        {% endfor %}
      </table>
    </div>
  </section>
  {% endif %}

  <section id="casos">
    <h2>Casos de Playwright</h2>
    {% set _max_ms = report.playwright.cases | map(attribute="duration_ms") | max if report.playwright.cases else 1 %}
    {% for case in report.playwright.cases %}
    <div class="card {% if case.status == 'passed' %}card--passed{% elif case.status == 'failed' %}card--failed{% elif case.status == 'skipped' %}card--skipped{% endif %}">
      <div class="case__title">
        {{ case.title }}
        {% if case.status == "passed" %}<span class="badge badge--ok">passed</span>
        {% elif case.status == "skipped" %}<span class="badge badge--skip">skipped</span>
        {% else %}<span class="badge badge--fail">{{ case.status }}</span>{% endif %}
      </div>
      <div class="case__meta">{{ case.duration_ms }} ms</div>
      <div class="case__bar"><div class="case__bar-fill" style="width: {{ (case.duration_ms / (_max_ms or 1) * 100) | round(1) }}%; background: {% if case.status == 'passed' %}var(--ok){% elif case.status == 'skipped' %}var(--muted){% else %}var(--err){% endif %};"></div></div>
      {% for err in case.errors %}
      <pre>{{ err }}</pre>
      {% endfor %}
    </div>
    {% else %}
    <div class="card">
      <p>No se pudo generar el reporte estructurado de Playwright. Salida cruda del proceso:</p>
      <pre>{{ report.playwright.raw_stdout }}</pre>
    </div>
    {% endfor %}
  </section>

  {% if report.extension_used %}
  {% if report.kpis_html %}
  <section id="kpis">
    <h2>KPIs de la sesión (CharlyAudit)</h2>
    <div class="card">{{ report.kpis_html | safe }}</div>
  </section>
  {% endif %}
  <section id="ambitos">
    <h2>Análisis del Asistente IA — por ámbito (15/15)</h2>
    {% for scope in report.assistant_scopes %}
    <details class="card scope-card" {% if loop.index <= 3 %}open{% endif %}>
      <summary>{{ scope.label }}</summary>
      <div class="body">{{ scope.html | safe }}</div>
    </details>
    {% endfor %}
  </section>
  {% endif %}

</main>
</div>
<footer>Generado por charlyWebAudit v{{ app_version }}</footer>
</body>
</html>
